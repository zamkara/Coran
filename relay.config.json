{
  "sources": {
    "release-stream": { "type": "gitlab", "secret": "RELEASE_INGRESS", "allow": ["group/project"] },
    "integration-stream": { "type": "github", "secret": "INTEGRATION_INGRESS", "allow": ["owner/repo"] },
    "deploy-runner": {
      "type": "hmac",
      "secret": "DEPLOY_INGRESS",
      "allow": ["web-app-staging", "web-app-production"],
      "ratePerMin": 30
    }
  },
  "destinations": {
    "deploys": { "secret": "RELEASE_EGRESS" },
    "alerts": { "secret": "INCIDENT_EGRESS" }
  },
  "routes": [
    { "source": "deploy-runner", "status": ["failed"], "to": ["deploys", "alerts"] },
    { "source": "deploy-runner", "to": ["deploys"] },
    { "source": "release-stream", "to": ["deploys"] },
    { "source": "integration-stream", "to": ["deploys"] }
  ]
}
